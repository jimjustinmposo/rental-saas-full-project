# Environment variables for local development
# Copy this file to .dev.vars and update values as needed
# .dev.vars is in .gitignore and never committed

# ============================================================
# FRONTEND & CORS
# ============================================================
FRONTEND_URL=http://localhost:3000

# ============================================================
# ADMIN ACCESS
# ============================================================
# Must match the password users enter when creating accounts
ADMIN_SIGNUP_PASSWORD=fmc10123

# ============================================================
# JWT SECRET
# ============================================================
# Used to sign/verify authentication tokens
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-dev-jwt-secret-key-change-in-production

# ============================================================
# ENVIRONMENT
# ============================================================
# REQUIRED for local development. The API only enables its dev fallbacks
# (shared dev JWT secret, localhost CORS ports) when NODE_ENV is exactly
# "development". Anything else - including unset - is treated as a live
# deployment and fails closed (login 500s, authenticated calls 401).
#
# Keep this line in .dev.vars, and never set it on a deployed environment.
NODE_ENV=development

# ============================================================
# R2 BUCKET URL (Optional)
# ============================================================
# If you have R2 configured, set the public URL for uploads
# Example: https://cdn.yourdomain.com
# Leave blank to use /uploads (local dev fallback)
R2_BUCKET_URL=

# ============================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================
# This is a Cloudflare Pages project, so secrets are stored per project AND per
# environment - `wrangler secret put` does not apply:
#
#   wrangler pages secret put JWT_SECRET --project-name rental-saas-prod --env production
#   wrangler pages secret put ADMIN_SIGNUP_PASSWORD --project-name rental-saas-prod --env production
#
# FRONTEND_URL is NOT a secret. It lives in wrangler.toml under
# [env.production.vars] / [env.preview.vars] so it stays in source control.
#
# Do NOT commit .dev.vars to git
# Always use unique, strong secrets in production
