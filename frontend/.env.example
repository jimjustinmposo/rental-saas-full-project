# API base URL for the React app.
#
# LEAVE THIS UNSET for Cloudflare Pages: the frontend and the Pages Functions
# are served from the same domain, so the app uses a relative "/api" path.
# Only set an absolute URL here when the API runs on a different host
# (e.g. http://localhost:8787/api for a separate local backend).
REACT_APP_API_BASE_URL=
